<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F1">

    <View
        android:id="@+id/weatherEffectView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- 1. LOGIN & SIGNUP SCREEN -->
    <LinearLayout
        android:id="@+id/layoutAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="എന്റെ കോട്ടായി 🌴"
            android:textColor="#1B5E20"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="തുടരുന്നതിനായി ലോഗിൻ ചെയ്യുക"
            android:textColor="#555555"
            android:textSize="13sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:id="@+id/etAuthEmail"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#EEEEEE"
                    android:hint="Email (ഉദാ: user@kottayi.com)"
                    android:inputType="textEmailAddress"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etAuthPassword"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="#EEEEEE"
                    android:hint="Password (പാസ്‌വേഡ്)"
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#1B5E20"
                    android:text="ലോഗിൻ ചെയ്യുക (Login)" />

                <Button
                    android:id="@+id/btnSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#2E7D32"
                    android:text="പുതിയ അക്കൗണ്ട് ഉണ്ടാക്കുക (Sign Up)" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 2. MAIN APPLICATION CONTENT -->
    <LinearLayout
        android:id="@+id/layoutMainApp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Header -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B5E20"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="എന്റെ കോട്ടായി 🌴"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWeatherBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#33FFFFFF"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="⛅ കോട്ടായി"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="കോട്ടായി പഞ്ചായത്ത് കൂലിപ്പണി &amp; സർവീസ്"
                android:textColor="#C8E6C9"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- View 1: Search Workers List -->
        <LinearLayout
            android:id="@+id/viewSearch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="visible">

            <Spinner
                android:id="@+id/spinnerFilterJob"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#ECEFF1" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/containerWorkersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- View 2: Worker Self-Registration -->
        <ScrollView
            android:id="@+id/viewRegister"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="തൊഴിലും കൂലിയും രജിസ്റ്റർ ചെയ്യാം 👷"
                            android:textColor="#1B5E20"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:background="#EEEEEE"
                            android:hint="നിങ്ങളുടെ പേര് (Name)"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="ഫോൺ നമ്പർ (Calling/WhatsApp)"
                            android:inputType="phone"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <Spinner
                            android:id="@+id/spinnerWorkerJob"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE" />

                        <EditText
                            android:id="@+id/etArea"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="സ്ഥലം / വാർഡ് (ഉദാ: കോട്ടായി ജംഗ്ഷൻ)"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etWage"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="കൂലി നിരക്ക് ₹"
                            android:inputType="number"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etUpiId"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="UPI ID (GPay/PhonePe)"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnSaveProfile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#1B5E20"
                            android:text="ക്ലൗഡിൽ സേവ് ചെയ്യുക (Publish)" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <!-- View 3: Profile & Google Play Store Data Deletion -->
        <ScrollView
            android:id="@+id/viewProfile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="എന്റെ പ്രൊഫൈൽ / ക്രമീകരണങ്ങൾ ⚙️"
                            android:textColor="#1B5E20"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvUserEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Account: -"
                            android:textColor="#555555"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnLogout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="#757575"
                            android:text="ലോഗൗട്ട് ചെയ്യുക (Log Out)" />

                        <!-- Mandatory Play Store Account Deletion -->
                        <Button
                            android:id="@+id/btnDeleteAccount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#D32F2F"
                            android:text="⚠️ അക്കൗണ്ടും ഡാറ്റയും പൂർണ്ണമായി ഇല്ലാതാക്കുക (Delete All Data)" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/navSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="🔍 പണികൾ"
                android:textColor="#1B5E20"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navRegister"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="👷 എന്റെ തൊഴിൽ"
                android:textColor="#555555"
                android:textSize="11sp" />

            <Button
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="👤 പ്രൊഫൈൽ"
                android:textColor="#555555"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Splash Screen -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1B5E20"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="എന്റെ കോട്ടായി"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeveloperCredit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:text="App developed by Sulfi Sulaiman ✨"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="italic|bold" />
    </LinearLayout>
</FrameLayout>
