<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A192F">

    <!-- പശ്ചാത്തലത്തിൽ കോട്ടായിയുടെ മനോഹര ചിത്രം -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/kottayi_bg" />

    <!-- ലിക്വിഡ് ഗ്ലാസ് ഫീലിനായുള്ള ഡാർക്ക് ബ്ലെൻഡ് ഓവർലേ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80061A24" />

    <!-- തത്സമയ മേഘങ്ങളും മഴയും -->
    <View
        android:id="@+id/weatherEffectView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- 1. ലിക്വിഡ് ഗ്ലാസ് ലോഗിൻ കാർഡ് -->
    <LinearLayout
        android:id="@+id/layoutAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="എന്റെ കോട്ടായി 🌴"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAuthHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="തുടരുന്നതിനായി ലോഗിൻ ചെയ്യുക"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <!-- ഫ്രോസ്റ്റഡ് ഗ്ലാസ് കണ്ടെയ്നർ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/glass_card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/etAuthEmail"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/glass_input_bg"
                android:hint="Email (ഉദാ: user@kottayi.com)"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#90A4AE"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etAuthPassword"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_input_bg"
                android:hint="Password (പാസ്‌വേഡ്)"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#90A4AE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#402E7D32"
                android:text="ലോഗിൻ ചെയ്യുക (Login)"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSignUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#26FFFFFF"
                android:text="പുതിയ അക്കൗണ്ട് ഉണ്ടാക്കുക"
                android:textColor="#E0E0E0" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. മെയിൻ ആപ്പ് ഡാഷ്‌ബോർഡ് -->
    <LinearLayout
        android:id="@+id/layoutMainApp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- ഗ്ലാസ് ഹെഡ്ഡർ -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#4D000000"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="എന്റെ കോട്ടായി 🌴"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWeatherBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_input_bg"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="⛅ കോട്ടായി"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="കോട്ടായി പഞ്ചായത്ത് കൂലിപ്പണി &amp; സർവീസ്"
                android:textColor="#B0BEC5"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- View 1: തിരയൽ പേജ് -->
        <LinearLayout
            android:id="@+id/viewSearch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="visible">

            <Spinner
                android:id="@+id/spinnerFilterJob"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/glass_card_bg" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/containerWorkersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- View 2: തൊഴിൽ രജിസ്ട്രേഷൻ പേജ് -->
        <ScrollView
            android:id="@+id/viewRegister"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="തൊഴിലും നിരക്കും രജിസ്റ്റർ ചെയ്യാം 👷"
                    android:textColor="#81C784"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/glass_input_bg"
                    android:hint="നിങ്ങളുടെ പേര് (Name)"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_input_bg"
                    android:hint="ഫോൺ നമ്പർ"
                    android:inputType="phone"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerWorkerJob"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_input_bg" />

                <!-- Driver Dynamic -->
                <LinearLayout
                    android:id="@+id/layoutDriverSpecific"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_input_bg"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etVehicleType"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/glass_input_bg"
                        android:hint="വാഹനം (Auto, Car, Pickup)"
                        android:padding="8dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#90A4AE"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <EditText
                            android:id="@+id/etRatePerKm"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/glass_input_bg"
                            android:hint="1 Km നിരക്ക് ₹"
                            android:inputType="number"
                            android:padding="8dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#90A4AE"
                            android:textSize="12sp" />

                        <View android:layout_width="6dp" android:layout_height="1dp" />

                        <EditText
                            android:id="@+id/etMinCharge"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/glass_input_bg"
                            android:hint="മിനിമം ചാർജ് ₹"
                            android:inputType="number"
                            android:padding="8dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#90A4AE"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Cook Dynamic -->
                <LinearLayout
                    android:id="@+id/layoutCookSpecific"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_input_bg"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etFoodItems"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/glass_input_bg"
                        android:hint="വിഭവങ്ങൾ (ബിരിയാണി, സദ്യ)"
                        android:padding="8dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#90A4AE"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etRatePerPlate"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/glass_input_bg"
                        android:hint="പ്ലേറ്റ് നിരക്ക് ₹"
                        android:inputType="number"
                        android:padding="8dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#90A4AE"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Climber Dynamic -->
                <LinearLayout
                    android:id="@+id/layoutClimberSpecific"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_input_bg"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etRatePerTree"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/glass_input_bg"
                        android:hint="1 തെങ്ങിന് നിരക്ക് ₹"
                        android:inputType="number"
                        android:padding="8dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#90A4AE"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- General Rate -->
                <LinearLayout
                    android:id="@+id/layoutGeneralWage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etWage"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/glass_input_bg"
                        android:hint="കൂലി നിരക്ക് ₹ (ദിവസം / പണിക്ക്)"
                        android:inputType="number"
                        android:padding="10dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#90A4AE"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etArea"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_input_bg"
                    android:hint="സ്ഥലം / വാർഡ് (ഉദാ: കോട്ടായി)"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etUpiId"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_input_bg"
                    android:hint="UPI ID (GPay/PhonePe)"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#402E7D32"
                    android:text="ക്ലൗഡിൽ സേവ് ചെയ്യുക (Publish)"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </ScrollView>

        <!-- View 3: പ്രൊഫൈൽ പേജ് -->
        <ScrollView
            android:id="@+id/viewProfile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="എന്റെ പ്രൊഫൈൽ ⚙️"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Account: -"
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#33FFFFFF"
                    android:text="ലോഗൗട്ട് ചെയ്യുക (Log Out)"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnDeleteAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#59D32F2F"
                    android:text="⚠️ അക്കൗണ്ടും ഡാറ്റയും ഇല്ലാതാക്കുക (Delete Data)"
                    android:textColor="#FFCDD2" />
            </LinearLayout>
        </ScrollView>

        <!-- ഗ്ലാസ് ബോട്ടം നാവിഗേഷൻ ബാർ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#4D000000"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/navSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="🔍 പണികൾ"
                android:textColor="#81C784"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navRegister"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="👷 എന്റെ തൊഴിൽ"
                android:textColor="#B0BEC5"
                android:textSize="11sp" />

            <Button
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="👤 പ്രൊഫൈൽ"
                android:textColor="#B0BEC5"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- പ്രീമിയം സ്പ്ലാഷ് സ്ക്രീൻ -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60A192F"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="എന്റെ കോട്ടായി 🌴"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeveloperCredit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:text="App developed by Sulfi Sulaiman ✨"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="italic|bold" />
    </LinearLayout>
</FrameLayout>
