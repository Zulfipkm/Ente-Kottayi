<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6">

    <!-- Main Dashboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B5E20"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="എന്റെ കോട്ടായി 🌴"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="കോട്ടായി പഞ്ചായത്ത് ലോക്കൽ തൊഴിൽ &amp; സർവീസ്"
                android:textColor="#C8E6C9"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Service Categories -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="സേവനം തിരഞ്ഞെടുക്കുക"
                    android:textColor="#2E7D32"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <Button
                        android:id="@+id/btnCategoryClimber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#2E7D32"
                        android:text="തെങ്ങ് കയറ്റം 🌴"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnCategoryDriver"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#388E3C"
                        android:text="ഡ്രൈവർ 🚗"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnCategoryElectrician"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#43A047"
                        android:text="ഇലക്ട്രീഷ്യൻ 💡"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Worker List Container -->
                <TextView
                    android:id="@+id/tvSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="തൊഴിലാളികൾ (കോട്ടായി)"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/workerListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- Add New Job / Worker Form Section -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="നിങ്ങൾ കോട്ടായിയിലെ തൊഴിലാളിയാണോ?"
                            android:textColor="#1B5E20"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="നിങ്ങളുടെ പേരും ദിവസക്കൂലിയും ഇവിടെ ചേർക്കൂ"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etWorkerName"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:background="#EEEEEE"
                            android:hint="പേര് (Name)"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etWorkerPhone"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="ഫോൺ നമ്പർ (Phone)"
                            android:inputType="phone"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etWorkerSkill"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="തൊഴിൽ (ഉദാ: പെയിന്റർ, പ്ലംബർ)"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etWorkerWage"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="കൂലി നിരക്ക് ₹ (ഉദാ: 850)"
                            android:inputType="number"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnAddWorker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#1B5E20"
                            android:text="തൊഴിൽ രജിസ്റ്റർ ചെയ്യുക (Register)" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Traditional Kerala Splash Screen Overlay -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1B5E20"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="എന്റെ കോട്ടായി"
            android:textColor="#FFD700"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="ഗ്രാമത്തിന്റെ കൂട്ടായ്മ • നാടിന്റെ നന്മ"
            android:textColor="#E8F5E9"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
