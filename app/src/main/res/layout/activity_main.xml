<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F1">

    <!-- Rain / Atmosphere Effect Overlay Canvas -->
    <View
        android:id="@+id/weatherEffectView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Dynamic Weather Header -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B5E20"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="എന്റെ കോട്ടായി 🌴"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- Live Kottayi Weather Badge -->
                <TextView
                    android:id="@+id/tvWeatherBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#33FFFFFF"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="☀️ കോട്ടായി"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="കോട്ടായി പഞ്ചായത്ത് കൂലിപ്പണി &amp; സർവീസ് നെറ്റ്‌വർക്ക്"
                android:textColor="#C8E6C9"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- View 1: Customer / Search Dashboard -->
        <LinearLayout
            android:id="@+id/viewSearch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="visible">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ആവശ്യമുള്ള തൊഴിൽ തിരഞ്ഞെടുക്കൂ 🔍"
                        android:textColor="#1B5E20"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerFilterJob"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="#ECEFF1" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/containerWorkersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- View 2: Worker Self-Registration Form -->
        <ScrollView
            android:id="@+id/viewRegister"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="തൊഴിലും കൂലിയും രജിസ്റ്റർ ചെയ്യാം 👷"
                            android:textColor="#1B5E20"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="കോട്ടായിയിലെ നാട്ടുകാർക്ക് നിങ്ങളെ നേരിട്ട് വിളിക്കാം"
                            android:textColor="#666666"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:background="#EEEEEE"
                            android:hint="നിങ്ങളുടെ പേര് (Name)"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="ഫോൺ നമ്പർ (Calling/WhatsApp)"
                            android:inputType="phone"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="തൊഴിൽ വിഭാഗം:"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinnerWorkerJob"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="#EEEEEE" />

                        <EditText
                            android:id="@+id/etCustomJob"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="മറ്റു പണിയാണെങ്കിൽ ഇവിടെ ടൈപ്പ് ചെയ്യുക"
                            android:padding="10dp"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <EditText
                            android:id="@+id/etArea"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="സ്ഥലം / വാർഡ് (ഉദാ: കോട്ടായി ജംഗ്ഷൻ)"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etWage"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="കൂലി നിരക്ക് ₹ (ദിവസം / എണ്ണം)"
                            android:inputType="number"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etUpiId"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEEEE"
                            android:hint="UPI ID (GPay / PhonePe പേയ്മെന്റ് ലഭിക്കാൻ)"
                            android:padding="10dp"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnSaveProfile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:backgroundTint="#1B5E20"
                            android:text="എന്റെ പ്രൊഫൈൽ സേവ് ചെയ്യുക 💾" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/navSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="🔍 പണികളെ തിരയുക"
                android:textColor="#1B5E20"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navRegister"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="👷 എന്റെ തൊഴിൽ ചേർക്കുക"
                android:textColor="#555555" />
        </LinearLayout>
    </LinearLayout>

    <!-- Traditional Splash Screen with Premium Credit Animation -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1B5E20"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="എന്റെ കോട്ടായി"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeveloperCredit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:text="App developed by Sulfi Sulaiman ✨"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="italic|bold" />

        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="കോട്ടായി പഞ്ചായത്ത് കൂലി &amp; സർവീസ്"
            android:textColor="#E8F5E9"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
